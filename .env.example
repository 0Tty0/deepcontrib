# Copy to .env only for local use. Never commit credentials.
DEEPCONTRIB_MODEL=openai:gpt-5.5
OPENAI_API_KEY=
# Qwen example through Alibaba Cloud Model Studio's OpenAI-compatible API:
# DEEPCONTRIB_MODEL=openai:qwen3.8-max
# OPENAI_API_KEY=<your DashScope API key>
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen's tool-compatible endpoint uses Chat Completions:
# DEEPCONTRIB_USE_RESPONSES_API=false
DATABASE_URL=postgresql://deepcontrib:deepcontrib@localhost:5432/deepcontrib
DEEPCONTRIB_DATA_DIR=./data
DEEPCONTRIB_MAX_TASK_SECONDS=1800
DEEPCONTRIB_MAX_MODEL_CALLS=40
# Optional: application-maintained Python/pytest image pinned by sha256 digest.
# DEEPCONTRIB_TEST_IMAGE=registry.example/python-pytest@sha256:<64-hex-digest>
